# VectorBleed Configuration
# Copy this to .env and fill in your values

# OpenAI API (required)
VECTORBLEED_OPENAI_API_KEY=sk-...
VECTORBLEED_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTORBLEED_OPENAI_GENERATION_MODEL=gpt-4o-mini

# Pinecone Cloud
VECTORBLEED_PINECONE_API_KEY=pcsk_...
VECTORBLEED_PINECONE_INDEX_NAME=vectorbleed-research
VECTORBLEED_PINECONE_ENVIRONMENT=us-east-1
VECTORBLEED_PINECONE_DIMENSION=1536

# Weaviate Cloud (https://console.weaviate.cloud)
VECTORBLEED_WEAVIATE_URL=https://your-cluster.weaviate.network
VECTORBLEED_WEAVIATE_API_KEY=your-weaviate-api-key

# Qdrant Cloud (https://cloud.qdrant.io)
VECTORBLEED_QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
VECTORBLEED_QDRANT_API_KEY=your-qdrant-api-key

# ChromaDB
# For embedded (no server): VECTORBLEED_CHROMA_HOST=localhost_embedded
# For cloud/docker: set host + optional API key
VECTORBLEED_CHROMA_HOST=localhost_embedded
VECTORBLEED_CHROMA_PORT=8000
VECTORBLEED_CHROMA_API_KEY=

# Tenant Configuration
VECTORBLEED_TENANT_A_NAMESPACE=tenant_financial
VECTORBLEED_TENANT_B_NAMESPACE=tenant_healthcare
VECTORBLEED_CORPUS_SIZE_PER_TENANT=50

# Experiment Settings
VECTORBLEED_EXPERIMENT_PROBE_COUNT=100
VECTORBLEED_EXPERIMENT_INVERSION_SAMPLES=200
VECTORBLEED_SIMILARITY_THRESHOLD=0.7

# Output
VECTORBLEED_RESULTS_DIR=results
VECTORBLEED_REPORTS_DIR=results/reports

# Logging
VECTORBLEED_LOG_LEVEL=INFO
VECTORBLEED_VERBOSE=false
